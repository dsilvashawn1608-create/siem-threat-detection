# Copy to .env and fill in real values. Any value set here (or as a real
# environment variable) overrides config/settings.yaml — see
# backend/app/config.py for the full precedence order.

ENVIRONMENT=development
DEBUG=false

DATABASE_URL=sqlite:////data/backend/siem.db

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Generate unique random values for local use; never commit the populated .env.
AUTH_SECRET_KEY=
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=

# Optional Google Gemini analysis. Leave blank to disable this feature.
GEMINI_API_KEY=

# --- Splunk ---
SPLUNK_HEC_URL=https://localhost:8088
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_INDEX=siem_threat_detection
SPLUNK_API_URL=https://localhost:8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=
SPLUNK_VERIFY_TLS=false

# --- Snort ---
SNORT_ALERT_LOG_PATH=/data/snort/log/alert

# --- Background sync / correlation / ML (all off by default — flip on
# once Splunk/Snort are actually reachable) ---
AUTO_SYNC_ENABLED=false
AUTO_CORRELATE_ENABLED=false
ML_SCORE_ON_INGEST_ENABLED=false
